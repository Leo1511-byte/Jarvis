# TypeScript incremental build cache — machine-specific, not meaningful to commit
tsconfig.tsbuildinfo
apps/desktop/frontend/tsconfig.tsbuildinfo

# scripts/benchmark_orchestrator.sh output — regenerable, timestamped per run;
